# ==============================================================================
# HyperText Configuration Template (.env.example)
# Copy to .env (`cp .env.example .env && chmod 600 .env`) and fill in real keys.
# ==============================================================================

# Primary LLM routing mode: deepseek (native thinking chain + server web tools) | openai (OpenAI-compatible isolated mode)
PROVIDER_MODE=deepseek

# DeepSeek V4.1-Flash (1M context + native multimodal vision + server tools)
DEEPSEEK_API_KEY=sk-替换为你的DeepSeek密钥
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
# Reasoning effort: high | medium | low | none
DEEPSEEK_REASONING_EFFORT=high
# Enable DeepSeek official server-side web search & URL reader (deepseek_web_search / deepseek_read_url)
ENABLE_DEEPSEEK_WEB_TOOLS=true

# OpenAI-compatible mode or automatic fallback channel
OPENAI_API_KEY=sk-替换为你的OpenAI密钥
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4.1-mini

# Optional dense embedding model for hybrid memory fusion (leave empty for pure SQLite FTS5 BM25 + exact boost)
EMBEDDING_MODEL=

# Admin iMessage whitelist (comma-separated phone numbers or Apple ID emails, e.g. +8613800138000,you@icloud.com)
ALLOWED_SENDERS=

# Same-Apple-ID iPhone Self-Chat Mode (4-layer anti-loop protection)
# Set ALLOW_SELF_CHAT=true when your iPhone and Mac mini Messages.app share the same Apple ID.
ALLOW_SELF_CHAT=false
SELF_CHAT_PREFIX=/ai
# Optional: pin all self-chat replies to a single handle/email (e.g. +8613800138000 or you@icloud.com)
SELF_CHAT_REPLY_TO=

# Multi-User Invite Beta & Daily Quotas
ENABLE_INVITE_CODES=false
# Optional comma-separated static bootstrap invite codes (e.g. HT-TEAM01,HT-FRIENDS)
INVITE_CODES=
MEMBER_DAILY_MSG_LIMIT=50
MEMBER_DAILY_BROWSER_LIMIT=10

# Local state & macOS Messages SQLite paths (~ expands automatically to current user's home directory)
HYPERTEXT_STATE_DIR=~/.hypertext
CHAT_DB_PATH=~/Library/Messages/chat.db
POLL_INTERVAL_SEC=1.5
CRON_INTERVAL_SEC=15.0
HUMAN_GATE_TIMEOUT_SEC=300

# Browser-Use 1.0 persistent local Chromium sandbox & multi-user concurrency pool
BROWSER_HEADLESS=false
BROWSER_MAX_STEPS=25
BROWSER_MAX_CONCURRENCY=3
BROWSER_SENSITIVE_JSON={}

# --- HyperText Conversational UX (v0.6.2 Single-Exit Quiet-Tool) ---
# Send a warm natural acknowledgment when a task takes longer than FAST_ACK_DELAY_SEC
ENABLE_INSTANT_ACK=true
FAST_ACK_DELAY_SEC=1.5
# Low-frequency reassurance interval (seconds after initial ack) & per-turn cap during extra-long tasks
HYPERTEXT_HEARTBEAT_INTERVAL_SEC=60.0
HYPERTEXT_MAX_HEARTBEAT_PER_TURN=1
# Send up to 3 reference links as separate pure-URL bubbles for native iOS Link Cards
SPLIT_STANDALONE_LINKS=true

# --- Optional Admin-Only Explicit XiaoNa / XiaoMiGuan Relay (v0.6.2) ---
# Triggered ONLY when the admin explicitly addresses `小纳` / `小蜜罐` / `/xiaona` / `/xiaomiguan`.
# Example endpoint format: https://xiaona-relay.example.com/ask
XIAONA_RELAY_URL=
XIAONA_RELAY_KEY=
XIAONA_TIMEOUT_SEC=600

# --- Optional Admin-Only Explicit Local Agent Matrix (v0.6.2: WorkBuddy / DSH / Codex / AGY / Dreamina) ---
# Optional explicit HTTP proxy for Codex & AGY (auto-probes http://127.0.0.1:7897 if left empty;
# 127.0.0.1,localhost,::1 are always forced into NO_PROXY for AGY gRPC & DSH Magpie).
HYPERTEXT_LOCAL_PROXY=

# WorkBuddy (`@tencent-ai/codebuddy-code` — triggered via `/wb`, `/workbuddy`, `让 workbuddy ...`)
WORKBUDDY_CLI_PATH=
WORKBUDDY_CONFIG_DIR=
WORKBUDDY_MODEL=
WORKBUDDY_TIMEOUT_SEC=600

# DeepSeek Harness (`dsh` — triggered via `/dsh`, `让 DSH ...`)
DSH_CLI_PATH=
DSH_MODEL=
DSH_TIMEOUT_SEC=600

# OpenAI Codex CLI (`codex` — triggered via `/codex`, `/cdx`, `让 codex ...`)
CODEX_CLI_PATH=
CODEX_MODEL=
CODEX_TIMEOUT_SEC=600

# Google Antigravity CLI (`agy` — triggered via `/agy`, `/antigravity`, `让 AGY ...`)
AGY_CLI_PATH=
AGY_MODEL=
AGY_TIMEOUT_SEC=600

# Dreamina Canvas CLI (`dreamina-canvas` / 即梦画布 — triggered via `/即梦`, `/jimeng`, `/dreamina`, `/jm`;
# strips foreign HTTP_PROXY/HTTPS_PROXY by default for domestic `--region cn` direct connection)
DREAMINA_CLI_PATH=
DREAMINA_HTTP_PROXY=
DREAMINA_TIMEOUT_SEC=600
